{
  "name": "dsh-plugins-pack",
  "version": "0.1.0",
  "private": true,
  "description": "A pack of small, independent DeepSeek Harness features. Each feature lives in its own subdirectory and is registered as a separate plugin entry.",
  "type": "module",
  "icon": "icon.png",
  "exports": {
    "./locale/*.json": "./locale/*.json",
    "./auto-auto-permission": "./auto-auto-permission/index.js",
    "./auto-auto-permission/locale/*.json": "./auto-auto-permission/locale/*.json",
    "./auto-auto-permission/icon": "./auto-auto-permission/icon.svg",
    "./fixed-native-script": "./fixed-native-script/index.js",
    "./fixed-native-script/locale/*.json": "./fixed-native-script/locale/*.json",
    "./fixed-native-script/icon": "./fixed-native-script/icon.svg",
    "./composer-key-swap": "./composer-key-swap/index.js",
    "./composer-key-swap/locale/*.json": "./composer-key-swap/locale/*.json",
    "./composer-key-swap/icon": "./composer-key-swap/icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "icon.png",
    "locale/*.json",
    "docs/*.md",
    "auto-auto-permission/index.js",
    "auto-auto-permission/locale/*.json",
    "auto-auto-permission/icon.svg",
    "auto-auto-permission/README.md",
    "fixed-native-script/index.js",
    "fixed-native-script/locale/*.json",
    "fixed-native-script/icon.svg",
    "fixed-native-script/README.md",
    "composer-key-swap/index.js",
    "composer-key-swap/client.js",
    "composer-key-swap/locale/*.json",
    "composer-key-swap/icon.svg",
    "composer-key-swap/README.md",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "format": "prettier --write \"**/*.{js,mjs,cjs}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,cjs}\""
  },
  "devDependencies": {
    "prettier": "^3.10.1"
  }
}
